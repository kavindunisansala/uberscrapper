{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "name": {
            "type": "string",
            "description": "Name of the restaurant"
        },
        "is_open": {
            "type": "boolean",
            "description": "Whether the restaurant is currently open"
        },
        "status_text": {
            "type": "string",
            "description": "Readable status (e.g. Open now, Accepting orders)"
        },
        "supported_apps": {
            "type": "array",
            "description": "List of food ordering platforms that support this restaurant"
        },
        "ordering_links": {
            "type": "object",
            "description": "Direct order/listing links by platform"
        },
        "address": {
            "type": "string",
            "description": "Full street address"
        },
        "street_address": {
            "type": "string",
            "description": "Street line"
        },
        "city": {
            "type": "string",
            "description": "City"
        },
        "state_region": {
            "type": "string",
            "description": "State or province"
        },
        "postal_code": {
            "type": "string",
            "description": "Postal code"
        },
        "country": {
            "type": "string",
            "description": "Country code or name"
        },
        "latitude": {
            "type": "number",
            "description": "GPS latitude of the restaurant"
        },
        "longitude": {
            "type": "number",
            "description": "GPS longitude of the restaurant"
        },
        "distance_or_delivery_time": {
            "type": "string",
            "description": "Distance or estimated delivery/transit time"
        },
        "rating": {
            "type": "number",
            "description": "Average review rating (out of 5)"
        },
        "rating_count": {
            "type": "string",
            "description": "Number of ratings or reviews"
        },
        "cuisines": {
            "type": "array",
            "description": "Cuisine categories (e.g. Pizza, Italian)"
        },
        "price_range": {
            "type": "string",
            "description": "Price level indicator (e.g. $, $$, $$$)"
        },
        "phone_number": {
            "type": "string",
            "description": "Contact phone number if available"
        },
        "primary_source": {
            "type": "string",
            "description": "Primary delivery discovery service (e.g. Uber Eats, Swiggy)"
        },
        "primary_url": {
            "type": "string",
            "description": "Primary storefront link"
        },
        "scraped_at": {
            "type": "string",
            "description": "ISO 8601 timestamp when scraped"
        }
    },
    "views": {
        "overview": {
            "title": "Restaurants Overview",
            "transformation": {
                "fields": [
                    "name",
                    "is_open",
                    "status_text",
                    "supported_apps",
                    "address",
                    "distance_or_delivery_time",
                    "rating",
                    "primary_url"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "name": {
                        "label": "Restaurant Name",
                        "format": "text"
                    },
                    "is_open": {
                        "label": "Open Now",
                        "format": "boolean"
                    },
                    "status_text": {
                        "label": "Status",
                        "format": "text"
                    },
                    "supported_apps": {
                        "label": "Ordering Apps",
                        "format": "array"
                    },
                    "address": {
                        "label": "Location / Address",
                        "format": "text"
                    },
                    "distance_or_delivery_time": {
                        "label": "Delivery / ETD",
                        "format": "text"
                    },
                    "rating": {
                        "label": "Rating",
                        "format": "number"
                    },
                    "primary_url": {
                        "label": "Storefront URL",
                        "format": "link"
                    }
                }
            }
        }
    }
}
